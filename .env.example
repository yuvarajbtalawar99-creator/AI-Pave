# AI-PAVE Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=aipave_db

# Model Paths
MODEL_PATH=artifacts/models/pothole_detector_yolo.pt
SEGMENTER_PATH=artifacts/models/pothole_segmenter_yolo.pt
DEPTH_MODEL_PATH=artifacts/models/depth_anything_v2.pt

# Storage Directories
UPLOAD_DIR=uploads
OUTPUT_DIR=processed
REPORTS_DIR=reports
EVALUATION_DIR=artifacts/evaluation

# Upload Limits
MAX_IMAGE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=200

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# Authentication & Google OAuth
JWT_SECRET_KEY=aipave-jwt-secret-key-production-ready-2026-road-inspection
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ML Inference Settings
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DEVICE=auto
USE_HALF_PRECISION=false
